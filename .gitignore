# Ambientes e caches Python
.venv/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Segredos e configurações locais
.env
.env.*
!.env.example
.python-version.local

# Dados, modelos e resultados gerados (manter apenas arquivos README)
/data/raw/**
!/data/raw/README.md
/data/processed/**
!/data/processed/README.md
/output/**
!/output/README.md
# Resultados consolidados do protocolo fechado (tabelas, resumo e figuras; sem checkpoints)
!/output/consolidado/
!/output/consolidado/**
# Modelos treinados: checkpoint, config, limiar congelado e histórico de cada run (MODELOS.md)
!/output/MODELOS.md
!/output/rlvs-*/
!/output/rlvs-*/best.pt
!/output/rlvs-*/effective_config.toml
!/output/rlvs-*/threshold.json
!/output/rlvs-*/manifest.json
!/output/rlvs-*/history.json
!/output/img/
/output/img/**
!/output/img/README.md
*.pt
*.pth
# Exceção: checkpoints publicados dos runs (ver output/MODELOS.md)
!/output/rlvs-*/best.pt
*.ckpt
*.h5
*.keras
*.onnx

# SO e IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs de jobs Slurm
/logs/
